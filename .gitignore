# macOS
.DS_Store

# エディタ
.vscode/
.idea/
*.swp

# 一時ファイル
*.tmp
*.bak

# 環境変数（アフィリエイトIDなど）
.env
.env.local
config/secrets.json

# ダウンロード済み画像（容量が大きいためgit管理外）
assets/images/**/*.jpg
assets/images/**/*.jpeg
assets/images/**/*.png
assets/images/**/*.webp
# credits.jsonはコミット対象（画像URLとクレジット情報）
!assets/images/**/credits.json
